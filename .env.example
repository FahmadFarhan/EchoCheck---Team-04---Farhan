# ==============================================================================
# SentinelVoice Environment Configuration
# ==============================================================================
# DetectifAI Deepfake Detection API Key
# Sign up and retrieve your key from: https://platform.detectif.ai
DETECTIF_API_KEY=your_detectif_api_key_here

# Optional Configurations:
# Timeout in seconds for DetectifAI API requests (default: 30)
DETECTIF_API_TIMEOUT=30

# SQLite Database Path (default: sentinel_voice.db)
SENTINEL_DB_PATH=sentinel_voice.db
